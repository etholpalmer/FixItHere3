<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>FixItHere uses your location to show nearby providers and track service arrival.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>FixItHere lets you attach photos to describe the job to your provider.</string>
	<!-- Pinned to Light.

	     Theme.fs uses concrete colours because MAUI does not surface iOS
	     semantic colours (label, systemBackground) through Fabulous, so a
	     device in Dark Mode would render dark chrome around a light-only app —
	     white bubbles on a black status bar, unreadable placeholder text. A
	     demo has no opportunity to recover from that.

	     This is a stopgap with a known cost: it also disables Dark Mode for
	     anyone who prefers it. Removing it is gated on a real dark palette,
	     which is tracked as Phase 4 work, not on someone noticing this later.
	  -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
